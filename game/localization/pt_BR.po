msgid "navigation.thresholds"
msgstr "Alertas locais: idade GNSS ≥{0} s ou σ 3D ≥{1} m"

msgid "navigation.alert.blackout"
msgstr "△ GNSS interrompido: o filtro continua propagando a trajetória"

msgid "navigation.alert.gnss_recent"
msgstr "◇ Solução GNSS recente"

msgid "navigation.alert.uncertain"
msgstr "△ Incerteza acima do limiar do filtro; não certifica precisão"

msgid "navigation.alert.within_model"
msgstr "◇ Incerteza abaixo do limiar de alerta do modelo"

msgid "navigation.badge.warning"
msgstr "△ INS"

msgid "navigation.model_limit"
msgstr "σ descreve o modelo do filtro, não o erro verdadeiro ou RMSE. Sem base conectada, o GNSS é autônomo. Checkpoints não entram no estimador. O diagnóstico reinicia ao carregar ou trocar plataforma."

msgid "navigation.status.waiting_velocity"
msgstr "○ Aguardando segunda posição GNSS para estimar velocidade"
