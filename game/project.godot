; Minimal .NET bootstrap for T-F01-01. Gameplay modules follow in T-F01-02.
config_version=5

[application]
config/name="GSA"
run/main_scene="res://Bootstrap.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Gsa"

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/screen_space_roughness_limiter/enabled=false
textures/default_filters/anisotropic_filtering_level=0
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.07, 1)
